# Public hostname. Create a DNS A/AAAA record before deploying.
DOMAIN=captions.example.com

# Leave these generated secrets empty: ./deploy.sh fills them in.
ADMIN_PASSWORD=
SESSION_SECRET=

# Required service credentials.
DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# HTTP port used by the Node.js process. Docker Compose overrides this to 3000.
PORT=3000

# Comma-separated lowercase room slugs. Each room needs TOKEN_<ROOM_SLUG>.
ROOMS=room-1,room-2,room-3,room-4
TOKEN_ROOM_1=
TOKEN_ROOM_2=
TOKEN_ROOM_3=
TOKEN_ROOM_4=

# Primary OpenAI-compatible translation provider.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Provider-specific request fields as a JSON object.
# Example for some gpt-oss providers: {"reasoning_effort":"low"}
OPENAI_EXTRA_BODY=
OPENAI_SERVICE_TIER=

# Optional provider used for final captions while the primary handles drafts.
FINAL_API_KEY=
FINAL_BASE_URL=https://api.openai.com/v1
FINAL_MODEL=gpt-4.1-mini
FINAL_EXTRA_BODY=
FINAL_SERVICE_TIER=

# Optional failover provider when the primary times out or fails.
FALLBACK_API_KEY=
FALLBACK_BASE_URL=https://api.openai.com/v1
FALLBACK_MODEL=gpt-4.1-mini
FALLBACK_EXTRA_BODY=

# Speech recognition and caption cadence.
DG_ENDPOINTING=300
DG_PT_LANGUAGE=multi
STT_PROXY=true
LIVE_DRAFTS=true
DRAFT_INTERVAL_MS=350
# Global cap shared by all rooms. Lower this for low provider rate limits.
DRAFTS_PER_SECOND=15
